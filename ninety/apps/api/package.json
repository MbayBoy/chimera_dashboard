{
  "name": "@ninety/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "bootstrap": "tsx src/db/migrate.ts && tsx src/db/seed.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:rollback": "tsx src/db/migrate.ts --down",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/migrate.ts --reset && tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest": "tsx src/testing/loadtest.ts",
    "seed:load": "tsx src/testing/seed-load.ts"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/multipart": "9.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/websocket": "11.0.1",
    "@ninety/shared": "workspace:*",
    "bullmq": "5.34.2",
    "drizzle-orm": "0.38.2",
    "fastify": "5.2.0",
    "ioredis": "5.4.2",
    "jose": "5.9.6",
    "postgres": "3.4.5",
    "sharp": "0.33.5",
    "stripe": "17.5.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
