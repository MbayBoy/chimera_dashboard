# ─── NINETY — environment ─────────────────────────────────────────────────────
# Copy to .env and fill in. Real values are never committed.
#
# Note what is NOT in this file: no currency, no tax rate, no commission rate,
# no SLA minutes, no locale. Those are market configuration and live in the
# `markets` table, editable by an admin without a deploy. Putting one here would
# be the same mistake as putting it in code.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Data ─────────────────────────────────────────────────────────────────────
# PostgreSQL 16 with the PostGIS extension. PostGIS is required, not optional.
DATABASE_URL=postgresql://ninety:ninety@localhost:5432/ninety
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ─── Media ────────────────────────────────────────────────────────────────────
# 's3' in every deployed environment; 'local' for tests and local development.
# EXIF is stripped on ingest either way — that is not a driver concern.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=.media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Payments ─────────────────────────────────────────────────────────────────
# Which provider is used is resolved per market from markets.payment_provider.
# These are the credentials for the providers that are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Push ─────────────────────────────────────────────────────────────────────
# Web push for the supplier terminal, native push for the buyer app.
FCM_SERVER_KEY=

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Buyer app ────────────────────────────────────────────────────────────────
# The app blocks and prompts to update below this version.
MIN_BUYER_APP_VERSION=1.0.0

# ─── Development only ─────────────────────────────────────────────────────────
# Returns the OTP in the verify response so a developer need not read the log.
# The process refuses to start with this enabled in production.
OTP_ECHO_IN_RESPONSE=false
# 1 means real time. Tests compress long waits by raising this.
TIMER_SPEED_FACTOR=1
