# ============================================================
# CHIMERA BACKEND v5.0 - Environment Configuration
# ============================================================
# All credentials are pre-configured for leadsconsult.co.za
# Copy this file to .env before starting the server:
#   cp env.example .env
# ============================================================

# --- REQUIRED: Supabase Configuration ---
# Get from: https://app.supabase.com -> Your Project -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# IMPORTANT: Use the SERVICE ROLE key (not the anon key)
# The service role key bypasses RLS and is required for backend operations
# NEVER expose this key in frontend code
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Server Configuration ---
NODE_ENV=production
PORT=3001

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://leadsconsult.co.za,https://www.leadsconsult.co.za,https://chimerada7417.builtwithrocket.new

# --- Cron Jobs ---
ENABLE_CRON_JOBS=true

# --- Rate Limiting ---
RATE_LIMIT_GENERAL=200
RATE_LIMIT_AUTH=10

# --- Email Alerts (Resend) ---
RESEND_API_KEY=re_HxdTktTu_AqzGCUohsrr17S8LWLvfoBAk
ALERT_FROM_EMAIL=alerts@leadsconsult.co.za
ALERT_TO_EMAIL=info@leadsconsult.co.za

# --- Bounce Processing (IMAP) ---
BOUNCE_IMAP_HOST=mail.leadsconsult.co.za
BOUNCE_IMAP_PORT=993
BOUNCE_IMAP_USER=bounces@leadsconsult.co.za
BOUNCE_IMAP_PASSWORD=your-bounce-mailbox-password
BOUNCE_IMAP_TLS=true

# FBL (Feedback Loop) mailbox
FBL_IMAP_HOST=mail.leadsconsult.co.za
FBL_IMAP_PORT=993
FBL_IMAP_USER=fbl@leadsconsult.co.za
FBL_IMAP_PASSWORD=your-fbl-mailbox-password
FBL_IMAP_TLS=true

# --- Agent API Keys ---
# Generate with: openssl rand -hex 32
AGENT_API_KEYS=generate-a-random-key-here

# --- PM2 Configuration ---
PM2_INSTANCES=1
PM2_MAX_MEMORY=512M

# --- Logging ---
LOG_LEVEL=info
